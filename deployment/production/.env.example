# SentinelSIEM Phase 19 production environment contract.
# Never commit real secret values.

SIEM_ENVIRONMENT=production
SIEM_DEBUG=false
SIEM_API_HOST=0.0.0.0
SIEM_API_PORT=8000
SIEM_LOG_LEVEL=INFO
SIEM_MAX_REQUEST_BYTES=10485760
SIEM_SHUTDOWN_TIMEOUT_SECONDS=30

# Authentication
SIEM_AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SIEM_AUTH_ALGORITHM=HS256
SIEM_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
SIEM_AUTH_ISSUER=sentinelsiem
SIEM_AUTH_AUDIENCE=sentinelsiem-api

# PostgreSQL
POSTGRES_DB=sentinelsiem
POSTGRES_USER=sentinelsiem
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_SECRET
SIEM_DATABASE_URL=postgresql+asyncpg://sentinelsiem:REPLACE_WITH_A_STRONG_SECRET@postgres:5432/sentinelsiem

# Redis
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_SECRET
REDIS_URL=redis://:REPLACE_WITH_A_STRONG_SECRET@redis:6379/0

# OpenSearch
OPENSEARCH_INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_SECRET
OPENSEARCH_URL=https://opensearch:9200

# Application runtime commands. Set these to real entrypoints from the live repo.
WORKER_COMMAND=REPLACE_WITH_REAL_WORKER_COMMAND
COLLECTOR_COMMAND=REPLACE_WITH_REAL_COLLECTOR_COMMAND

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=/api/v1
